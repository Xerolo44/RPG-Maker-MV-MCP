{
  "name": "@xerolo44/rpgmaker-mv-mcp",
  "version": "0.5.0",
  "description": "MCP server for reading, editing, and playtesting RPG Maker MV projects",
  "type": "module",
  "mcpName": "io.github.Xerolo44/rpgmaker-mv-mcp",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "rpgmaker-mv-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run build && npm run test:unit && node scripts/smoke.mjs",
    "test:unit": "node scripts/run-unit.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rpg-maker-mv",
    "rpgmaker"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xerolo44/RPG-Maker-MV-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/Xerolo44/RPG-Maker-MV-MCP/issues"
  },
  "homepage": "https://github.com/Xerolo44/RPG-Maker-MV-MCP#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "selfsigned": "^5.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
